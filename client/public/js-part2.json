function drawWheel(){var c=document.getElementById('wheel-canvas');if(!c)return;var cx=c.getContext('2d'),pa=c.parentElement;c.width=pa.offsetWidth*(window.devicePixelRatio||1);c.height=pa.offsetHeight*(window.devicePixelRatio||1);cx.clearRect(0,0,c.width,c.height);cx.scale(window.devicePixelRatio||1,window.devicePixelRatio||1);var ox=pa.offsetWidth/2,oy=pa.offsetHeight/2,rr=Math.min(ox,oy)-8;var cal=ML.reduce(function(s,m){return s+m.totalCalories},0);var prot=ML.reduce(function(s,m){return s+m.totalProtein},0);var cs=[{v:Math.min(1,cal/2000)*0.5+Math.min(1,prot/170)*0.5,c:'#f59e0b'},{v:Math.min(1,(WL&&WL.total||0)/2000),c:'#3b82f6'},{v:0.6,c:'#7c3aed'},{v:0.3,c:'#22c55e'}];var aa=-Math.PI/2,st=2*Math.PI/cs.length;cs.forEach(function(s){cx.beginPath();cx.moveTo(ox,oy);cx.arc(ox,oy,rr,aa,aa+st);cx.closePath();cx.fillStyle='#2a2a3a';cx.fill();cx.beginPath();cx.moveTo(ox,oy);cx.arc(ox,oy,rr*s.v,aa,aa+st);cx.closePath();cx.fillStyle=s.c;cx.fill();aa+=st});cx.beginPath();cx.arc(ox,oy,rr*0.3,0,2*Math.PI);cx.fillStyle='#1a1a24';cx.fill()}
function drawWeightChart(){if(WC){WC.destroy();WC=null}var c=document.getElementById('weight-chart');if(!c)return;var m=(HL||[]).filter(function(x){return x.weight}).slice(-14);if(m.length<2){c.getContext('2d').fillText('Недостаточно данных',c.width/2,20);return}WC=new Chart(c.getContext('2d'),{type:'line',data:{labels:m.map(function(x){return new Date(x.date).toLocaleDateString('ru',{day:'2-digit',month:'2-digit'})}),datasets:[{label:'Вес',data:m.map(function(x){return x.weight}),borderColor:'#22c55e',backgroundColor:'rgba(34,197,94,0.1)',fill:true,tension:0.3,pointRadius:4}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{grid:{color:'rgba(255,255,255,0.05)'},ticks:{color:'var(--text2)',maxTicksLimit:7}},y:{grid:{color:'rgba(255,255,255,0.05)'},ticks:{color:'var(--text2)'}}}}})}
function renderMeals(f){var items=f==='all'?ML:ML.filter(function(m){return m.type===f});var cal=0,prot=0,fat=0,carbs=0;items.forEach(function(m){cal+=m.totalCalories;prot+=m.totalProtein;fat+=m.totalFat;carbs+=m.totalCarbs});document.getElementById('meal-total-cal').textContent=Math.round(cal);document.getElementById('meal-total-p').textContent=Math.round(prot);document.getElementById('meal-total-f').textContent=Math.round(fat);document.getElementById('meal-total-c').textContent=Math.round(carbs);var h='';items.forEach(function(m){var n={breakfast:'🌅 Завтрак',lunch:'☀️ Обед',dinner:'🌙 Ужин',snack:'🍪 Перекус'};h+='<div class="meal-card"><div><span style="font-weight:600">'+(n[m.type]||m.type)+'</span><span style="color:var(--orange);font-weight:700;float:right">'+Math.round(m.totalCalories)+' ккал</span></div><div style="font-size:12px;color:var(--text2);margin-top:4px">б:'+Math.round(m.totalProtein)+'г · ж:'+Math.round(m.totalFat)+'г · у:'+Math.round(m.totalCarbs)+'г</div>';if(m.items&&m.items.length){h+='<div style="margin-top:4px;font-size:12px;color:var(--text2)">';m.items.forEach(function(it){h+='▸ '+it.name+'<br>'});h+='</div>'}h+='<button style="float:right;font-size:12px;background:none;border:none;cursor:pointer;color:var(--red);margin-top:-20px" onclick="delMeal(\''+m.id+'\')">🗑</button></div>'});if(!h)h='<p style="color:var(--text2);text-align:center;padding:20px">Нет записей</p>';document.getElementById('meals-list').innerHTML=h}
function filterMeals(f,el){document.querySelectorAll('.tab').forEach(function(t){t.classList.remove('active')});if(el)el.classList.add('active');renderMeals(f)}
function delMeal(id){if(!confirm('Удалить?'))return;api('DELETE','/meals/'+id,null,function(e){if(e){toast(e);return}toast('Удалено');var t=(new Date()).toISOString().split('T')[0];api('GET','/meals?date='+t,null,function(e2,d){if(!e2){ML=d||[];renderMeals('all');renderDash()}})})}
function showAddMeal(){document.getElementById('meal-type').value='breakfast';var d=new Date();d.setMinutes(d.getMinutes()-d.getTimezoneOffset());document.getElementById('meal-datetime').value=d.toISOString().slice(0,16);document.getElementById('meal-items-container').innerHTML='';addMealItemInput();showModal('meal-modal')}
var _productCache=[];function addMealItemInput(){var i=Date.now();var d=document.getElementById('meal-items-container');var div=document.createElement('div');div.className='form-row';div.id='mi-'+i;div.innerHTML='<div style="flex:2;position:relative"><input type="text" id="mi-n-'+i+'" placeholder="Продукт" style="width:100%;padding:8px;border:1px solid var(--border);border-radius:6px;background:var(--bg);box-sizing:border-box" autocomplete="off" oninput="searchProduct(this,'+i+')"><div id="mi-s-'+i+'" style="position:absolute;top:100%;left:0;right:0;background:var(--bg2);border:1px solid var(--border);border-radius:6px;max-height:200px;overflow-y:auto;z-index:50;display:none"></div></div><div style="flex:0.6"><input type="number" id="mi-g-'+i+'" placeholder="г" value="100" style="width:100%;padding:8px;border:1px solid var(--border);border-radius:6px;background:var(--bg);box-sizing:border-box" step="10" min="1" oninput="calcNutrition('+i+')"></div><div style="flex:0.7"><input type="text" id="mi-r-'+i+'" placeholder="ккал" style="width:100%;padding:8px;border:1px solid var(--border);border-radius:6px;background:var(--bg3);box-sizing:border-box" readonly></div>';d.appendChild(div)}
var _st=[];function searchProduct(inp,i){var q=inp.value.trim().toLowerCase();var el=document.getElementById('mi-s-'+i);if(!q||q.length<2){el.style.display='none';return}if(!_productCache.length){api('GET','/meals/search?q='+encodeURIComponent(q),null,function(e,d){if(e)return;_productCache=d||[];showSuggestions(i,q)})}else{showSuggestions(i,q)}}
function showSuggestions(i,q){var el=document.getElementById('mi-s-'+i);var matches=_productCache.filter(function(p){return(p.nameRu||'').toLowerCase().includes(q)||p.name.toLowerCase().includes(q)}).slice(0,8);if(!matches.length){el.style.display='none';return}var h='';matches.forEach(function(p){h+='<div style="padding:6px 10px;cursor:pointer;font-size:13px" onclick="selectProduct('+i+',\''+p.id+'\',\''+(p.nameRu||p.name)+'\')">'+(p.nameRu||p.name)+' <span style="color:var(--text2);font-size:11px">'+Math.round(p.caloriesPer100g)+' ккал</span></div>'});el.innerHTML=h;el.style.display='block'}
function selectProduct(i,pid,pname){document.getElementById('mi-n-'+i).value=pname;document.getElementById('mi-n-'+i).dataset.productId=pid;document.getElementById('mi-s-'+i).style.display='none';calcNutrition(i)}
function calcNutrition(i){var pid=document.getElementById('mi-n-'+i).dataset.productId;var g=parseFloat(document.getElementById('mi-g-'+i).value)||0;var r=document.getElementById('mi-r-'+i);if(!pid||!g){r.value='';return}var prod=_productCache.find(function(p){return p.id===pid});if(!prod){r.value='';return}var factor=g/100;r.value=Math.round(prod.caloriesPer100g*factor)+' ккал';r.dataset.calories=prod.caloriesPer100g*factor;r.dataset.protein=prod.proteinPer100g*factor;r.dataset.fat=prod.fatPer100g*factor;r.dataset.carbs=prod.carbsPer100g*factor}
function saveMeal(){var items=[];document.querySelectorAll('#meal-items-container .form-row').forEach(function(row){var id=row.id.replace('mi-','');var n=document.getElementById('mi-n-'+id);if(!n||!n.value)return;var r=document.getElementById('mi-r-'+id);items.push({name:n.value,calories:parseFloat(r&&r.dataset.calories)||0,protein:parseFloat(r&&r.dataset.protein)||0,fat:parseFloat(r&&r.dataset.fat)||0,carbs:parseFloat(r&&r.dataset.carbs)||0,portion:parseFloat(document.getElementById('mi-g-'+id).value)||100})});if(!items.length){toast('Добавьте продукты');return}var data={type:document.getElementById('meal-type').value,datetime:document.getElementById('meal-datetime').value,items:items};api('POST','/meals',data,function(e){if(e){toast(e);return}closeModal('meal-modal');toast('Добавлено!');var t=(new Date()).toISOString().split('T')[0];api('GET','/meals?date='+t,null,function(e2,d){if(!e2){ML=d||[];renderMeals('all');renderDash()}})})}
function renderWater(){var t=(WL&&WL.total)||0,g=(WL&&WL.goal)||2000,p=Math.min(100,Math.round(t/g*100));document.getElementById('water-total').textContent=t;document.getElementById('water-percent').textContent=p+'%';var cups=Math.ceil(g/250),full=Math.floor(t/250),h='';for(var i=0;i<cups;i++){h+='<div class="water-cup'+(i<full?' filled':'')+'" onclick="addWater()">💧</div>'}document.getElementById('water-grid').innerHTML=h}
function addWater(){api('POST','/water',{amount:250},function(e){if(e){toast(e);return}toast('+250 мл');api('GET','/water/today',null,function(e2,w){if(!e2){WL=w||{};renderWater();renderDash()}})})}
function renderHealth(){if(!HL||!HL.length)return;var s=HL.slice().sort(function(a,b){return new Date(b.date)-new Date(a.date)}),l=s[0];document.getElementById('h-weight').textContent=l.weight?l.weight.toFixed(1)+' кг':'--';document.getElementById('h-pressure').textContent=(l.systolic&&l.diastolic)?l.systolic+'/'+l.diastolic:'--';document.getElementById('h-pulse').textContent=l.pulse?l.pulse+' уд':'--';if(l.sleepQuality)document.getElementById('sl-sleep').value=l.sleepQuality;if(l.stress)document.getElementById('sl-stress').value=l.stress;if(l.energy)document.getElementById('sl-energy').value=l.energy;if(l.morningErection)document.getElementById('sl-morning').value=l.morningErection;['sl-sleep','sl-stress','sl-energy','sl-morning'].forEach(function(id){var sl=document.getElementById(id),v=document.getElementById(id+'-v');if(sl&&v){sl.oninput=function(){v.textContent=this.value};v.textContent=sl.value}});drawPressureChart(s)}
function saveHealthChecklist(){var data={sleepQuality:parseInt(document.getElementById('sl-sleep').value),stress:parseInt(document.getElementById('sl-stress').value),energy:parseInt(document.getElementById('sl-energy').value),morningErection:parseInt(document.getElementById('sl-morning').value)};api('POST','/health',data,function(e){if(e){toast(e);return}toast('Сохранено');loadAll()})}
function showAddHealth(){showModal('health-modal')}
function saveHealthMetric(){var d={};var w=parseFloat(document.getElementById('hm-weight').value);if(w)d.weight=w;var s=parseInt(document.getElementById('hm-sys').value),di=parseInt(document.getElementById('hm-dia').value);if(s)d.systolic=s;if(di)d.diastolic=di;var p=parseInt(document.getElementById('hm-pulse').value);if(p)d.pulse=p;if(!w&&!s){toast('Заполните вес или давление');return}api('POST','/health',d,function(e){if(e){toast(e);return}closeModal('health-modal');toast('Сохранено');loadAll()})}
function drawPressureChart(s){if(PC){PC.destroy();PC=null}var c=document.getElementById('pressure-chart');if(!c)return;var m=s.filter(function(x){return x.systolic&&x.diastolic}).slice(-14);if(m.length<2){c.getContext('2d').fillText('Недостаточно данных',c.width/2,20);return}PC=new Chart(c.getContext('2d'),{type:'line',data:{labels:m.map(function(x){return new Date(x.date).toLocaleDateString('ru',{day:'2-digit',month:'2-digit'})}),datasets:[{label:'Верхнее',data:m.map(function(x){return x.systolic}),borderColor:'#ef4444',tension:0.3,pointRadius:3,fill:false},{label:'Нижнее',data:m.map(function(x){return x.diastolic}),borderColor:'#3b82f6',tension:0.3,pointRadius:3,fill:false}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{color:'var(--text2)',boxWidth:12}}},scales:{x:{grid:{color:'rgba(255,255,255,0.05)'},ticks:{color:'var(--text2)',maxTicksLimit:7}},y:{grid:{color:'rgba(255,255,255,0.05)'},ticks:{color:'var(--text2)'}}}}})}
function aiAnalyze(){document.getElementById('ai-advice').textContent='Анализирую...';api('POST','/ai/analyze',{date:new Date().toISOString()},function(e,d){if(e){document.getElementById('ai-advice').textContent='Ошибка: '+e;return}document.getElementById('ai-advice').textContent=d.advice})}
function aiChat(){var inp=document.getElementById('ai-input'),msg=inp.value.trim();if(!msg)return;inp.value='';var box=document.getElementById('ai-chat');box.innerHTML+='<div class="chat-msg user">'+msg+'</div>';box.innerHTML+='<div class="chat-msg ai" style="color:var(--text2)">Печатает...</div>';api('POST','/ai/chat',{message:msg},function(e,d){var msgs=box.querySelectorAll('.chat-msg');if(msgs.length&&msgs[msgs.length-1].textContent==='Печатает...')msgs[msgs.length-1].remove();if(e){box.innerHTML+='<div class="chat-msg ai" style="color:var(--red)">Ошибка: '+e+'</div>';return}box.innerHTML+='<div class="chat-msg ai">'+d.response+'</div>';box.scrollTop=box.scrollHeight})}
