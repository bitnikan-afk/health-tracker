var TK=localStorage.getItem('ht_tk'),ML=[],HL=[],WL={},WC=null,PC=null;
function api(m,p,b,cb){var x=new XMLHttpRequest();x.open(m,'/api/v1'+p,true);x.setRequestHeader('Content-Type','application/json');if(TK)x.setRequestHeader('Authorization','Bearer '+TK);x.onload=function(){var d=null;try{d=JSON.parse(x.responseText)}catch(e){}if(x.status>=200&&x.status<300){if(cb)cb(null,d)}else{if(cb)cb(d&&d.error?d.error:'Ошибка '+x.status)}};x.onerror=function(){if(cb)cb('Сервер недоступен')};if(b)x.send(JSON.stringify(b));else x.send()}
(function(){if(TK){api('GET','/auth/me',null,function(e,u){if(e)return;document.getElementById('auth-screen').style.display='none';document.getElementById('app').style.display='block';loadAll()})}else{document.getElementById('auth-screen').style.display='flex'}})();
function doLogin(){var e=document.getElementById('login-email').value,p=document.getElementById('login-password').value,er=document.getElementById('login-error');api('POST','/auth/login',{email:e,password:p},function(err,d){if(err){er.style.display='block';er.textContent=err;return}TK=d.accessToken;localStorage.setItem('ht_tk',TK);document.getElementById('auth-screen').style.display='none';document.getElementById('app').style.display='block';loadAll()})}
function toggleTheme(){document.body.classList.toggle('light')}
function navigate(pg){document.querySelectorAll('.page').forEach(function(p){p.classList.remove('active')});document.getElementById('page-'+pg).classList.add('active');document.querySelectorAll('.nav-icons button').forEach(function(b){b.classList.remove('active')});var n=document.getElementById('nav-'+pg);if(n)n.classList.add('active');if(pg==='dashboard')renderDash();if(pg==='meals')renderMeals('all');if(pg==='water')renderWater();if(pg==='health')renderHealth()}
function toast(m){var t=document.getElementById('toast');t.textContent=m;t.style.display='block';setTimeout(function(){t.style.display='none'},2500)}
function closeModal(id){document.getElementById(id).classList.remove('show')}
function showModal(id){document.getElementById(id).classList.add('show')}
function loadAll(){var t=(new Date()).toISOString().split('T')[0];api('GET','/meals?date='+t,null,function(e,d){if(!e){ML=d||[];renderMeals('all');renderDash()}});var f=new Date(Date.now()-30*86400000).toISOString().split('T')[0];api('GET','/health?from='+f,null,function(e,d){if(!e){HL=d||[];renderHealth();renderDash()}});api('GET','/water/today',null,function(e,d){if(!e){WL=d||{};renderWater();renderDash()}})}
function renderDash(){document.getElementById('dash-date').textContent=new Date().toLocaleDateString('ru',{weekday:'long',day:'numeric',month:'long'}).replace(/^./,function(x){return x.toUpperCase()});var cal=0,prot=0;ML.forEach(function(m){cal+=m.totalCalories;prot+=m.totalProtein});document.getElementById('dash-cal').textContent=Math.round(cal);document.getElementById('dash-protein').textContent=Math.round(prot);document.getElementById('dash-water').textContent=(WL&&WL.total)||0;var lw='--';if(HL&&HL.length){var s=HL.slice().sort(function(a,b){return new Date(b.date)-new Date(a.date)});lw=s[0].weight?s[0].weight.toFixed(1):'--'}document.getElementById('dash-weight').textContent=lw;drawWheel();drawWeightChart();var h='';ML.forEach(function(m){var n={breakfast:'🌅 Завтрак',lunch:'☀️ Обед',dinner:'🌙 Ужин',snack:'🍪 Перекус'};h+='<div class="meal-card"><div><span style="font-weight:600">'+(n[m.type]||m.type)+'</span> <span style="color:var(--orange);font-weight:700;float:right">'+Math.round(m.totalCalories)+' ккал</span></div><div style="font-size:12px;color:var(--text2);margin-top:4px">б:'+Math.round(m.totalProtein)+'г · ж:'+Math.round(m.totalFat)+'г · у:'+Math.round(m.totalCarbs)+'г</div></div>'});if(!h)h='<p style="color:var(--text2);text-align:center;padding:16px">Нет записей</p>';document.getElementById('dash-meals').innerHTML=h}
